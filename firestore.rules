rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function isProjectMember(projectId) {
      return signedIn()
        && request.auth.uid in project(projectId).data.memberIds;
    }

    function isProjectOwner(projectId) {
      return signedIn()
        && project(projectId).data.ownerId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 50;

      allow get, list: if signedIn()
        && request.auth.uid in resource.data.memberIds;

      allow update: if isProjectOwner(projectId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 50;

      allow delete: if isProjectOwner(projectId);

      match /clips/{clipId} {
        allow read: if isProjectMember(projectId);
        allow create, update: if isProjectMember(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.id == clipId
          && request.resource.data.posterPath == null
          && !request.resource.data.keys().hasAny([
            "sourcePath",
            "absolutePath",
            "localPath"
          ]);
        allow delete: if isProjectOwner(projectId);
      }
    }
  }
}
