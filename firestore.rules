rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function project(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId));
    }

    function isProjectMember(projectId) {
      return signedIn()
        && request.auth.uid in project(projectId).data.memberIds;
    }

    function isProjectOwner(projectId) {
      return signedIn()
        && project(projectId).data.ownerId == request.auth.uid;
    }

    function hasNoLocalPathFields(data) {
      return !data.keys().hasAny([
        "sourcePath",
        "absolutePath",
        "localPath",
        "audioPath"
      ]);
    }

    match /projects/{projectId} {
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() <= 50
        && !request.resource.data.keys().hasAny(["usage"]);

      allow get, list: if signedIn()
        && request.auth.uid in resource.data.memberIds;

      allow update: if isProjectOwner(projectId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "name",
          "brief",
          "knownNames",
          "terminology",
          "budgetPerFootageHour",
          "memberIds",
          "updatedAt"
        ]);

      allow delete: if isProjectOwner(projectId);

      match /clips/{clipId} {
        allow read: if isProjectMember(projectId);
        allow create: if isProjectMember(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.id == clipId
          && request.resource.data.posterPath == null
          && hasNoLocalPathFields(request.resource.data);
        allow update: if isProjectMember(projectId)
          && request.resource.data.projectId == projectId
          && request.resource.data.id == clipId
          && request.resource.data.posterPath == null
          && hasNoLocalPathFields(request.resource.data)
          && (!request.resource.data.keys().hasAny(["description"])
            || (request.resource.data.description is string
              && request.resource.data.description.size() <= 3000))
          && (!request.resource.data.keys().hasAny(["tags"])
            || (request.resource.data.tags is list
              && request.resource.data.tags.size() <= 40))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fingerprint",
            "filename",
            "fileExtension",
            "portableDirectoryHint",
            "durationMs",
            "frameRate",
            "startTimecodeFrames",
            "recordedAt",
            "sourceModifiedAt",
            "width",
            "height",
            "videoCodec",
            "audioCodec",
            "hasAudio",
            "fileSizeBytes",
            "posterPath",
            "stage",
            "error",
            "description",
            "tags",
            "visualEditedAt",
            "visualUpdatedAt",
            "updatedAt"
          ]);
        allow delete: if isProjectOwner(projectId);

        match /transcriptChunks/{chunkId} {
          allow read: if isProjectMember(projectId);
          allow create, update: if isProjectMember(projectId)
            && request.resource.data.projectId == projectId
            && request.resource.data.clipId == clipId
            && request.resource.data.id == chunkId
            && hasNoLocalPathFields(request.resource.data);
          allow delete: if isProjectMember(projectId);
        }

        match /transcriptUtterances/{utteranceId} {
          allow read: if isProjectMember(projectId);
          allow create, update: if isProjectMember(projectId)
            && request.resource.data.projectId == projectId
            && request.resource.data.clipId == clipId
            && request.resource.data.id == utteranceId
            && hasNoLocalPathFields(request.resource.data);
          allow delete: if isProjectMember(projectId);
        }

        match /visualFrames/{frameId} {
          allow read: if isProjectMember(projectId);
          allow create: if isProjectMember(projectId)
            && request.resource.data.projectId == projectId
            && request.resource.data.clipId == clipId
            && request.resource.data.id == frameId
            && request.resource.data.stage == "ready"
            && request.resource.data.timestampMs is int
            && request.resource.data.timestampMs >= 0
            && request.resource.data.width is int
            && request.resource.data.width > 0
            && request.resource.data.width <= 384
            && request.resource.data.height is int
            && request.resource.data.height > 0
            && request.resource.data.height <= 384
            && request.resource.data.fileSizeBytes is int
            && request.resource.data.fileSizeBytes > 0
            && request.resource.data.fileSizeBytes <= 100 * 1024
            && request.resource.data.storagePath
              == "projects/" + projectId + "/clips/" + clipId
                + "/frames/" + frameId + ".jpg"
            && hasNoLocalPathFields(request.resource.data);
          allow update: if isProjectMember(projectId)
            && request.resource.data.projectId == projectId
            && request.resource.data.clipId == clipId
            && request.resource.data.id == frameId
            && request.resource.data.stage == "ready"
            && request.resource.data.storagePath
              == "projects/" + projectId + "/clips/" + clipId
                + "/frames/" + frameId + ".jpg"
            && hasNoLocalPathFields(request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "updatedAt"
            ]);
          allow delete: if isProjectMember(projectId);
        }

        match /visualMoments/{momentId} {
          allow read: if isProjectMember(projectId);
          allow create: if false;
          allow update: if isProjectMember(projectId)
            && request.resource.data.projectId == projectId
            && request.resource.data.clipId == clipId
            && request.resource.data.id == momentId
            && request.resource.data.description is string
            && request.resource.data.description.size() <= 1000
            && request.resource.data.tags is list
            && request.resource.data.tags.size() <= 40
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              "description",
              "tags",
              "updatedAt"
            ]);
          allow delete: if isProjectOwner(projectId);
        }
      }

      match /visualJobs/{jobId} {
        allow read: if isProjectMember(projectId);
        allow write: if false;
      }

      match /usageEvents/{eventId} {
        allow read: if isProjectMember(projectId);
        allow write: if false;
      }

      match /usageReservations/{reservationId} {
        allow read, write: if false;
      }
    }
  }
}
